# CodeGuard AI v2.1 - Environment Variables
# Copy this file to backend/.env and fill in your values.

# --- AI provider (required) ---
# Option A - OpenRouter gateway (recommended):
GLM_API_KEY=your_openrouter_key_here
GLM_API_URL=https://openrouter.ai/api/v1/chat/completions
GLM_MODEL=z-ai/glm-4.7-flash
#
# Option B - Zhipu AI direct (open.bigmodel.cn):
# GLM_API_KEY=your_zhipu_key_here
# GLM_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
# GLM_MODEL=glm-4-flash

# --- Server (optional) ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# --- Security ---

# API key authentication (REQUIRED in production).
# Every /api call (except /api/health and share-link reads) requires
# header: X-API-Key: <value>. Verified with constant-time comparison.
# Comma-separate multiple keys for zero-downtime rotation.
# Generate:  python -c "import secrets; print(secrets.token_hex(32))"
CG_API_TOKEN=

# Set "false" ONLY for local development to skip auth.
# The server will REFUSE TO START without CG_API_TOKEN when this is true.
REQUIRE_API_AUTH=true

# CORS: comma-separated origins for local dev only. Leave empty in production
# (the frontend is served from the same origin).
CORS_ORIGINS=http://localhost:3000

# Set true only in local development to expose /docs, /redoc, /openapi.json.
# Documentation endpoints return 404 in production by default.
DOCS_ENABLED=false

# Stable secret for HMAC-signing share links (REQUIRED in production).
# Without it, tokens stop working after every server restart.
# Generate:  python -c "import secrets; print(secrets.token_hex(32))"
SHARE_SECRET=

# Share-link lifetime in seconds (default 24h)
SHARE_TTL_SECONDS=86400

# --- Rate limiting (optional) ---
# Redis URL for distributed rate limiting. Without it, limits are
# in-memory (single instance, reset on deploy/restart).
# REDIS_URL=redis://localhost:6379
