# CodeGuard AI - Environment Variables
# Copy this file to .env and fill in your values

# GLM API Configuration
# Option A - OpenRouter gateway (recommended, easy signup):
GLM_API_KEY=your_openrouter_key_here
GLM_API_URL=https://openrouter.ai/api/v1/chat/completions
GLM_MODEL=z-ai/glm-4.7-flash
# Other good models: z-ai/glm-5.2:free (free tier), z-ai/glm-5.3 (most capable)
#
# Option B - Zhipu AI direct (open.bigmodel.cn):
# GLM_API_KEY=your_zhipu_key_here
# GLM_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
# GLM_MODEL=glm-4-flash

# Backend Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# CORS (comma-separated allowed origins)
CORS_ORIGINS=http://localhost:3000
